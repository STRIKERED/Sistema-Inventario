@page "/reportes/cortes-de-caja"
@model Inventario.Web.Pages.Reportes.CortesDeCajaModel
@using Inventario.Core.Enums

@{
    ViewBag.Title = "Reporte de cortes de caja";
}

@section styles
{

}

@await Html.PartialAsync("~/Pages/Shared/Partials/_PageTitle.cshtml", new {
pageTitle = "Cortes de caja",
pageSubTitle1 = "Inventario",
pageSubTitle2 = "Reportes",
pageSubText = (string?)null
})

<div class="main-content">
    @if (!string.IsNullOrEmpty(Model.ErrorMensaje))
    {
        <div class="alert alert-danger" role="alert">@Model.ErrorMensaje</div>
    }

    <div class="row">
        <div class="col-sm-12">
            <div class="card shadow-0 mb-g">
                <div class="card-body">
                    <form method="get" class="row g-3 align-items-end">
                        <div class="col-auto">
                            <label asp-for="Desde" class="form-label">Desde</label>
                            <input asp-for="Desde" class="form-control" type="date" />
                        </div>
                        <div class="col-auto">
                            <label asp-for="Hasta" class="form-label">Hasta</label>
                            <input asp-for="Hasta" class="form-control" type="date" />
                        </div>
                        <div class="col-auto">
                            <button type="submit" class="btn btn-primary">Filtrar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-sm-12">
            <div class="card shadow-0 mb-g">
                <div class="card-header">
                    <div class="card-title">
                        Cortes (@Model.Cortes.Count) — Diferencia acumulada:
                        <span class="@(Model.TotalDiferencias != 0 ? "text-danger" : "")">@Model.TotalDiferencias.ToString("C2")</span>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-bordered table-striped table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Caja</th>
                                    <th>Apertura</th>
                                    <th>Cierre</th>
                                    <th>Estado</th>
                                    <th>Monto final (sistema)</th>
                                    <th>Monto final (contado)</th>
                                    <th>Diferencia</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Cortes.Count == 0)
                                {
                                    <tr>
                                        <td colspan="8" class="text-center">No hay cortes en este periodo.</td>
                                    </tr>
                                }
                                @foreach (var corte in Model.Cortes)
                                {
                                    <tr>
                                        <td>@corte.CajaNombre</td>
                                        <td>@corte.FechaApertura.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>@(corte.FechaCierre?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                                        <td>
                                            @if (corte.Estado == EstadoCorteDeCaja.Abierto)
                                            {
                                                <span class="badge bg-success">Abierto</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Cerrado</span>
                                            }
                                        </td>
                                        <td>@corte.MontoFinalSistema.ToString("C2")</td>
                                        <td>@corte.MontoFinalContado.ToString("C2")</td>
                                        <td class="@(corte.Diferencia != 0 ? "text-danger fw-bold" : "")">@corte.Diferencia.ToString("C2")</td>
                                        <td class="text-end">
                                            <a asp-page="/Caja/DetalleCorte" asp-route-id="@corte.Id" class="btn btn-outline-secondary btn-sm">Ver</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
