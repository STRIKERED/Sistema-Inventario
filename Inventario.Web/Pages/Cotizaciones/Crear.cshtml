@page "/cotizaciones/crear"
@model Inventario.Web.Pages.Cotizaciones.CrearModel

@{
    ViewBag.Title = "Nueva cotización";
}

@section styles
{

}

@await Html.PartialAsync("~/Pages/Shared/Partials/_PageTitle.cshtml", new {
pageTitle = "Nueva cotización",
pageSubTitle1 = "Inventario",
pageSubTitle2 = "Cotizaciones",
pageSubText = (string?)null
})

<div class="main-content">
    <div class="row">
        <div class="col-lg-9">
            <div class="card shadow-0 mb-g">
                <div class="card-body">

                    @if (!string.IsNullOrEmpty(Model.ErrorMensaje))
                    {
                        <div class="alert alert-danger" role="alert">@Model.ErrorMensaje</div>
                    }

                    <form method="post">
                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <label asp-for="ClienteNombre" class="form-label">Cliente (opcional)</label>
                                <input asp-for="ClienteNombre" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="ClienteContacto" class="form-label">Contacto (opcional)</label>
                                <input asp-for="ClienteContacto" class="form-control" />
                            </div>
                            <div class="col-md-2">
                                <label asp-for="FechaVigencia" class="form-label">Vigente hasta</label>
                                <input asp-for="FechaVigencia" class="form-control" type="date" />
                            </div>
                            <div class="col-md-2">
                                <label asp-for="Descuento" class="form-label">Descuento</label>
                                <input asp-for="Descuento" class="form-control" type="number" step="0.01" min="0" />
                            </div>
                        </div>

                        <label class="form-label fw-bold">Productos</label>
                        <div class="table-responsive mb-3">
                            <table class="table table-bordered mb-0">
                                <thead>
                                    <tr>
                                        <th style="width: 60%">Producto</th>
                                        <th>Cantidad</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (var i = 0; i < Model.MaximoLineas; i++)
                                    {
                                        <tr>
                                            <td>
                                                <select name="LineaProductoId[@i]" class="form-select">
                                                    <option value="">—</option>
                                                    @foreach (var producto in Model.Productos)
                                                    {
                                                        <option value="@producto.Id">@producto.Sku — @producto.Nombre (@producto.PrecioVenta.ToString("C2"))</option>
                                                    }
                                                </select>
                                            </td>
                                            <td>
                                                <input name="LineaCantidad[@i]" class="form-control" type="number" min="0" value="0" />
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="form-text mb-3">Deja en blanco (o en 0) las filas que no uses.</div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">Guardar cotización</button>
                            <a asp-page="/Cotizaciones/Index" class="btn btn-outline-secondary">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
