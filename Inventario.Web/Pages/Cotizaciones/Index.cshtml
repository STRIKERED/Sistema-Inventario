@page "/cotizaciones"
@model Inventario.Web.Pages.Cotizaciones.IndexModel
@using Inventario.Core.Enums

@{
    ViewBag.Title = "Cotizaciones";
}

@section styles
{

}

@await Html.PartialAsync("~/Pages/Shared/Partials/_PageTitle.cshtml", new {
pageTitle = "Cotizaciones",
pageSubTitle1 = "Inventario",
pageSubTitle2 = (string?)null,
pageSubText = (string?)null
})

<div class="main-content">
    @if (!string.IsNullOrEmpty(Model.ErrorMensaje))
    {
        <div class="alert alert-danger" role="alert">@Model.ErrorMensaje</div>
    }

    <div class="row">
        <div class="col-sm-12">
            <div class="card shadow-0 mb-g">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div class="card-title">Cotizaciones (@Model.Cotizaciones.Count)</div>
                    <a asp-page="/Cotizaciones/Crear" class="btn btn-primary btn-sm">Nueva cotización</a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-bordered table-striped table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Folio</th>
                                    <th>Cliente</th>
                                    <th>Fecha</th>
                                    <th>Vigente hasta</th>
                                    <th>Estado</th>
                                    <th>Total</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Cotizaciones.Count == 0)
                                {
                                    <tr>
                                        <td colspan="7" class="text-center">No hay cotizaciones registradas.</td>
                                    </tr>
                                }
                                @foreach (var cotizacion in Model.Cotizaciones)
                                {
                                    var claseBadge = cotizacion.Estado switch
                                    {
                                        EstadoCotizacion.Vigente => "bg-success",
                                        EstadoCotizacion.Convertida => "bg-primary",
                                        EstadoCotizacion.Vencida => "bg-warning text-dark",
                                        _ => "bg-secondary"
                                    };
                                    <tr>
                                        <td>@cotizacion.Folio</td>
                                        <td>@(cotizacion.ClienteNombre ?? "—")</td>
                                        <td>@cotizacion.FechaCreacion.ToString("dd/MM/yyyy")</td>
                                        <td>@(cotizacion.FechaVigencia?.ToString("dd/MM/yyyy") ?? "—")</td>
                                        <td><span class="badge @claseBadge">@cotizacion.Estado</span></td>
                                        <td>@cotizacion.Total.ToString("C2")</td>
                                        <td class="text-end">
                                            <a asp-page="/Cotizaciones/Detalle" asp-route-id="@cotizacion.Id" class="btn btn-outline-secondary btn-sm">Ver</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
