@page "/productos"
@model Inventario.Web.Pages.Productos.IndexModel

@{
    ViewBag.Title = "Productos";
}

@section styles
{

}

@await Html.PartialAsync("~/Pages/Shared/Partials/_PageTitle.cshtml", new {
pageTitle = "Productos",
pageSubTitle1 = "Inventario",
pageSubTitle2 = (string?)null,
pageSubText = (string?)null
})

<div class="main-content">
    @if (!string.IsNullOrEmpty(Model.ErrorMensaje))
    {
        <div class="alert alert-danger" role="alert">@Model.ErrorMensaje</div>
    }

    <div class="row">
        <div class="col-sm-12">
            <div class="card shadow-0 mb-g">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div class="card-title">Catálogo de productos</div>
                    <a asp-page="/Productos/Crear" class="btn btn-primary btn-sm">Nuevo producto</a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-bordered table-striped table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>SKU</th>
                                    <th>Nombre</th>
                                    <th>Categoría</th>
                                    <th>Precio venta</th>
                                    <th>Disponible</th>
                                    <th>Activo</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Productos.Count == 0 && string.IsNullOrEmpty(Model.ErrorMensaje))
                                {
                                    <tr>
                                        <td colspan="7" class="text-center">No hay productos registrados en este Inventario.</td>
                                    </tr>
                                }
                                @foreach (var producto in Model.Productos)
                                {
                                    <tr>
                                        <td>@producto.Sku</td>
                                        <td>@producto.Nombre</td>
                                        <td>@(producto.Categoria ?? "—")</td>
                                        <td>@producto.PrecioVenta.ToString("C2")</td>
                                        <td>
                                            @if (producto.CantidadDisponible <= producto.StockMinimo)
                                            {
                                                <span class="badge bg-warning text-dark">@producto.CantidadDisponible</span>
                                            }
                                            else
                                            {
                                                @producto.CantidadDisponible
                                            }
                                        </td>
                                        <td>
                                            @if (producto.Activo)
                                            {
                                                <span class="badge bg-success">Sí</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">No</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <a asp-page="/Productos/Detalle" asp-route-id="@producto.Id" class="btn btn-outline-secondary btn-sm">Ver</a>
                                            <a asp-page="/Productos/Editar" asp-route-id="@producto.Id" class="btn btn-outline-primary btn-sm">Editar</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
