@page "/productos/crear"
@model Inventario.Web.Pages.Productos.CrearModel

@{
    ViewBag.Title = "Nuevo producto";
}

@section styles
{

}

@await Html.PartialAsync("~/Pages/Shared/Partials/_PageTitle.cshtml", new {
pageTitle = "Nuevo producto",
pageSubTitle1 = "Inventario",
pageSubTitle2 = "Productos",
pageSubText = (string?)null
})

<div class="main-content">
    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-0 mb-g">
                <div class="card-body">

                    @if (!string.IsNullOrEmpty(Model.ErrorMensaje))
                    {
                        <div class="alert alert-danger" role="alert">@Model.ErrorMensaje</div>
                    }

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <form method="post">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label asp-for="Sku" class="form-label">SKU</label>
                                <input asp-for="Sku" class="form-control" />
                                <span asp-validation-for="Sku" class="text-danger fs-sm"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="CodigoBarras" class="form-label">Código de barras</label>
                                <input asp-for="CodigoBarras" class="form-control" />
                                <span asp-validation-for="CodigoBarras" class="text-danger fs-sm"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Unidad" class="form-label">Unidad</label>
                                <input asp-for="Unidad" class="form-control" placeholder="Pza, Kg, ..." />
                            </div>

                            <div class="col-md-8">
                                <label asp-for="Nombre" class="form-label">Nombre</label>
                                <input asp-for="Nombre" class="form-control" />
                                <span asp-validation-for="Nombre" class="text-danger fs-sm"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Categoria" class="form-label">Categoría</label>
                                <input asp-for="Categoria" class="form-control" />
                            </div>

                            <div class="col-md-3">
                                <label asp-for="PrecioCosto" class="form-label">Precio de costo</label>
                                <input asp-for="PrecioCosto" class="form-control" type="number" step="0.01" min="0" />
                                <span asp-validation-for="PrecioCosto" class="text-danger fs-sm"></span>
                            </div>
                            <div class="col-md-3">
                                <label asp-for="PrecioVenta" class="form-label">Precio de venta</label>
                                <input asp-for="PrecioVenta" class="form-control" type="number" step="0.01" min="0" />
                                <span asp-validation-for="PrecioVenta" class="text-danger fs-sm"></span>
                            </div>
                            <div class="col-md-3">
                                <label asp-for="CantidadDisponible" class="form-label">Cantidad inicial</label>
                                <input asp-for="CantidadDisponible" class="form-control" type="number" min="0" />
                                <span asp-validation-for="CantidadDisponible" class="text-danger fs-sm"></span>
                            </div>
                            <div class="col-md-3">
                                <label asp-for="StockMinimo" class="form-label">Stock mínimo</label>
                                <input asp-for="StockMinimo" class="form-control" type="number" min="0" />
                                <span asp-validation-for="StockMinimo" class="text-danger fs-sm"></span>
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-primary">Guardar producto</button>
                            <a asp-page="/Productos/Index" class="btn btn-outline-secondary">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
