@page "/auth-login"
@model Inventario.Web.Pages.Auth.LoginModel

@{
    ViewBag.Title = "Iniciar sesión";
    Layout = "~/Pages/Shared/_BaseLayout.cshtml";
}

@section styles
{

}

<nav class="navbar navbar-expand-lg navbar-dark position-fixed w-100 py-3" style="z-index: 1000;">
    <div class="container">
        <a class="navbar-brand" href="/">
            <img alt="logo" src="img/logo-light.svg" />
        </a>
    </div>
</nav>
<section class="hero-section position-relative overflow-hidden">
    <div class="container" style="position: relative; z-index: 1;">
        <div class="row justify-content-center">
            <div class="col-11 col-md-8 col-lg-6 col-xl-4">
                <div class="login-card p-4 p-md-6 bg-dark bg-opacity-50 translucent-dark rounded-4">
                    <h2 class="text-center mb-4">Sistema de Inventario</h2>
                    <p class="text-center text-white opacity-50 mb-4">Ingresa con tu usuario y contraseña</p>

                    @if (!string.IsNullOrEmpty(Model.MensajeError))
                    {
                        <div class="alert alert-danger" role="alert">@Model.MensajeError</div>
                    }

                    <form method="post">
                        <input type="hidden" asp-for="ReturnUrl" />
                        <div class="mb-3">
                            <label class="form-label" for="NombreUsuario">Usuario</label>
                            <input asp-for="NombreUsuario"
                                class="form-control form-control-lg text-white bg-dark border-light border-opacity-25 bg-opacity-25"
                                required autofocus autocomplete="username" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="Password">Contraseña</label>
                            <input asp-for="Password" type="password"
                                class="form-control form-control-lg text-white bg-dark border-light border-opacity-25 bg-opacity-25"
                                required autocomplete="current-password" />
                        </div>
                        <div class="d-grid mb-3">
                            <button class="btn btn-primary btn-lg bg-primary bg-opacity-75" type="submit">Entrar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section scripts
{
    <script src="~/plugins/bootstrap/bootstrap.bundle.min.js"></script>
}
