@page "/ventas/{id:int}"
@model Inventario.Web.Pages.Ventas.DetalleModel

@{
    ViewBag.Title = Model.Venta is null ? "Venta" : $"Venta {Model.Venta.Folio}";
}

@section styles
{

}

@await Html.PartialAsync("~/Pages/Shared/Partials/_PageTitle.cshtml", new {
pageTitle = Model.Venta?.Folio,
pageSubTitle1 = "Inventario",
pageSubTitle2 = "Ventas",
pageSubText = (string?)null
})

<div class="main-content">
    @if (Model.Venta is { } venta)
    {
        <div class="row">
            <div class="col-lg-5">
                <div class="card shadow-0 mb-g">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <div class="card-title">Datos de la venta</div>
                        @if (venta.Cancelada)
                        {
                            <span class="badge bg-danger">Cancelada</span>
                        }
                    </div>
                    <div class="card-body">
                        <dl class="row mb-0">
                            <dt class="col-5">Folio</dt>
                            <dd class="col-7">@venta.Folio</dd>

                            <dt class="col-5">Fecha</dt>
                            <dd class="col-7">@venta.Fecha.ToString("dd/MM/yyyy HH:mm")</dd>

                            <dt class="col-5">Método de pago</dt>
                            <dd class="col-7">@venta.MetodoPago</dd>

                            <dt class="col-5">Usuario</dt>
                            <dd class="col-7">@(venta.UsuarioNombre ?? "—")</dd>
                        </dl>

                        <a asp-page="/Ventas/Detalle" asp-route-id="@venta.Id" asp-page-handler="Ticket" class="btn btn-outline-secondary btn-sm mt-2">
                            Descargar ticket (ESC/POS)
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-lg-3">
                <div class="card shadow-0 mb-g">
                    <div class="card-body">
                        <dl class="row mb-0">
                            <dt class="col-7">Subtotal</dt>
                            <dd class="col-5 text-end">@venta.Subtotal.ToString("C2")</dd>

                            <dt class="col-7">Descuento</dt>
                            <dd class="col-5 text-end">@venta.Descuento.ToString("C2")</dd>

                            <dt class="col-7">Impuestos</dt>
                            <dd class="col-5 text-end">@venta.Impuestos.ToString("C2")</dd>

                            <dt class="col-7 fw-bold fs-lg">Total</dt>
                            <dd class="col-5 text-end fw-bold fs-lg">@venta.Total.ToString("C2")</dd>
                        </dl>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card shadow-0 mb-g h-100">
                    <div class="card-body d-flex flex-column justify-content-center">
                        <a asp-page="/Ventas/Index" class="btn btn-outline-secondary">Volver al historial</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-sm-12">
                <div class="card shadow-0 mb-g">
                    <div class="card-header">
                        <div class="card-title">Productos</div>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-bordered table-striped table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>Producto</th>
                                        <th>Cantidad</th>
                                        <th>Precio unitario</th>
                                        <th>Descuento</th>
                                        <th>Importe</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var detalle in venta.Detalles)
                                    {
                                        <tr>
                                            <td>@(detalle.ProductoNombre ?? $"Producto #{detalle.ProductoId}")</td>
                                            <td>@detalle.Cantidad</td>
                                            <td>@detalle.PrecioUnitario.ToString("C2")</td>
                                            <td>@detalle.DescuentoUnitario.ToString("C2")</td>
                                            <td>@detalle.ImporteLinea.ToString("C2")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
