@page "/configuracion/tienda"
@model Inventario.Web.Pages.Configuracion.TiendaModel

@{
    ViewBag.Title = "Datos de la tienda";
}

@section styles
{

}

@await Html.PartialAsync("~/Pages/Shared/Partials/_PageTitle.cshtml", new {
pageTitle = "Datos de la tienda",
pageSubTitle1 = "Administración",
pageSubTitle2 = "Configuración",
pageSubText = (string?)null
})

<div class="main-content">
    <div class="row">
        <div class="col-lg-6">
            <div class="card shadow-0 mb-g">
                <div class="card-body">

                    @if (!string.IsNullOrEmpty(Model.MensajeExito))
                    {
                        <div class="alert alert-success" role="alert">@Model.MensajeExito</div>
                    }
                    @if (!string.IsNullOrEmpty(Model.ErrorMensaje))
                    {
                        <div class="alert alert-danger" role="alert">@Model.ErrorMensaje</div>
                    }

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <form method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="mb-3">
                            <label asp-for="Nombre" class="form-label">Nombre</label>
                            <input asp-for="Nombre" class="form-control" />
                            <span asp-validation-for="Nombre" class="text-danger fs-sm"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Direccion" class="form-label">Dirección (opcional)</label>
                            <input asp-for="Direccion" class="form-control" />
                        </div>
                        <button type="submit" class="btn btn-primary">Guardar cambios</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
