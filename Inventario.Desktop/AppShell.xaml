<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Inventario.Desktop.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Inventario.Desktop.Views"
    FlyoutBehavior="Flyout"
    Title="Administrador de Inventario">

    <Shell.FlyoutHeader>
        <Grid Padding="16" HeightRequest="80" BackgroundColor="{AppThemeBinding Light=#512BD4, Dark=#2B0B98}"
              ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Image Grid.Column="0" Source="logo.jpg" HeightRequest="48" WidthRequest="48" Aspect="AspectFit" />
            <Label Grid.Column="1" x:Name="EncabezadoUsuarioLabel" Text="Administrador de Inventario"
                   TextColor="White" FontAttributes="Bold" FontSize="16" VerticalOptions="Center" LineBreakMode="TailTruncation" />
        </Grid>
    </Shell.FlyoutHeader>

    <Shell.FlyoutFooter>
        <VerticalStackLayout Spacing="4" Padding="12">
            <Button Text="Cerrar sesión" Clicked="OnCerrarSesionClicked" />
            <Label Text="Creador: Haroldo Mata Velázquez" FontSize="11" Opacity="0.6" HorizontalTextAlignment="Center" Margin="0,8,0,0" />
            <Label x:Name="VersionLabel" FontSize="11" Opacity="0.6" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </Shell.FlyoutFooter>

    <!-- Pantalla de login: sin flyout ni barra de navegación, para que se vea a pantalla completa. -->
    <ShellContent
        Title="Login"
        Route="login"
        ContentTemplate="{DataTemplate views:LoginPage}"
        Shell.FlyoutBehavior="Disabled"
        Shell.NavBarIsVisible="False" />

    <FlyoutItem Title="Punto de venta" Route="venta">
        <ShellContent ContentTemplate="{DataTemplate views:VentaPage}" Route="ventaContenido" />
    </FlyoutItem>

    <FlyoutItem Title="Cotizaciones" Route="cotizaciones">
        <ShellContent ContentTemplate="{DataTemplate views:CotizacionesPage}" Route="cotizacionesContenido" />
    </FlyoutItem>

    <FlyoutItem Title="Caja" Route="caja">
        <ShellContent ContentTemplate="{DataTemplate views:CajaPage}" Route="cajaContenido" />
    </FlyoutItem>

    <!-- IsVisible se controla desde AppShell.xaml.cs: solo Administrador puede dar de alta usuarios. -->
    <FlyoutItem x:Name="UsuariosFlyoutItem" Title="Usuarios" Route="usuarios" IsVisible="False">
        <ShellContent ContentTemplate="{DataTemplate views:UsuariosPage}" Route="usuariosContenido" />
    </FlyoutItem>

    <!-- IsVisible se controla desde AppShell.xaml.cs: solo Administrador puede crear/editar inventarios. -->
    <FlyoutItem x:Name="InventariosFlyoutItem" Title="Inventarios" Route="inventarios" IsVisible="False">
        <ShellContent ContentTemplate="{DataTemplate views:InventariosPage}" Route="inventariosContenido" />
    </FlyoutItem>

    <!-- IsVisible se controla desde AppShell.xaml.cs: solo Administrador puede exportar/importar la base. -->
    <FlyoutItem x:Name="RespaldoFlyoutItem" Title="Respaldo" Route="respaldo" IsVisible="False">
        <ShellContent ContentTemplate="{DataTemplate views:RespaldoPage}" Route="respaldoContenido" />
    </FlyoutItem>

    <!-- IsVisible se controla desde AppShell.xaml.cs: solo Administrador/Gerente pueden configurar la impresora
         (la Api restringe el POST/PUT de ConfiguracionesImpresion a esos mismos roles). -->
    <FlyoutItem x:Name="ConfiguracionImpresionFlyoutItem" Title="Impresión" Route="configuracionImpresion" IsVisible="False">
        <ShellContent ContentTemplate="{DataTemplate views:ConfiguracionImpresionPage}" Route="configuracionImpresionContenido" />
    </FlyoutItem>

</Shell>
